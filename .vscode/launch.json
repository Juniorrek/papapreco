{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "/usr/bin/brave-browser",
        },
        {
            "name": "papapreco",
            "request": "launch",
            "program": "lib/main.dart",
            "type": "dart"
        },
        {
            "name": "papapreco (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "papapreco (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Flutter for web",

            "type": "dart",
            "request": "launch",
            "runtimeExecutable": "/usr/bin/brave-browser",
            //"program": "lib/main.dart",
            "args": [
              "-d chrome",
              //"chrome"
            ]
          },
          {
            "name": "Flutter WEb",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
              "-d",
              "chrome"
            ]
          }
    ]
}